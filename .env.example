# Copy to .env and adjust. Real environment variables override these.

# Server
PORT=3000
# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from other machines / when hosted
HOST=127.0.0.1

# Google service account (use ONE of the two)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Sheets (both must be shared with the service account's client_email as Viewer)
ATTRITION_SHEET_ID=1jT8Lo0SAdCnkhbg6oeqi-bVOIhEAIO1wrt2P1nakhwI
TA_SHEET_ID=1JELHBP1rJym7rxwgDGLzN45GzgULmrHZ15JhijXWtu8

# How often the server re-reads both sheets in the background (seconds)
CACHE_SECONDS=30
